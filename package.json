{
	"name": "my-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "node --env-file=.env ./src/server.js",
		"cli": "npx vite-node ./cli/index.ts",
		"dev": "vite dev",
		"tools": "node --inspect --env-file=.env ./src/server.js",
		"debug": "vite --debug",
		"route-tree": "SKIP_ENV_VALIDATION=1 pnpm script create-route-tree.ts",
		"build": "SKIP_ENV_VALIDATION=1 pnpm route-tree && SKIP_ENV_VALIDATION=1 NODE_OPTIONS='--max-old-space-size=4096' vite build",
		"build:docs": "pnpm script build-docs",
		"preview": "vite preview",
		"build:email": "pnpm script mjml-batch",
		"check:system": "pnpm format && pnpm lint && pnpm check && pnpm test && pnpm build:docs",
		"system:check": "pnpm check:system",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "eslint --fix --no-cache .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run && pnpm test:e2e",
		"test:e2e": "pnpm build && playwright test",
		"test:e2e:no-build": "playwright test",
		"test:integration": "pnpm script test-integration",
		"script": "vite-node --config vite.config.ts ./scripts/index.ts",
		"fix-readme": "pnpm script fix-readme.ts",
		"backup": "pnpm script backup",
		"restore": "pnpm script restore",
		"docs:preview": "vitepress preview docs",
		"prepare": "husky install",
		"sb:start": "npx supabase start > supabase/sb-start.log",
		"sb:stop": "npx supabase stop",
		"sb:pull-types": "pnpm script supabase/sb-pull-types",
		"sb": "npx supabase",
		"sb:db": "pnpm script supabase/sb-db",
		"sb:reset": "pnpm sb:db db reset",
		"sb:restart": "pnpm sb:stop && pnpm sb:start",
		"sb:local-config": "pnpm script supabase/sb-local-config",
		"sb:push": "pnpm sb:db db push",
		"sb:pull": "pnpm script supabase/sb-pull",
		"sb:diff": "npx supabase db diff",
		"sb:status": "npx supabase status",
		"sb:migration": "npx supabase migration new",
		"sb:backup": "pnpm script supabase/sb-backup",
		"sb:restore": "pnpm script supabase/sb-restore"
	},
